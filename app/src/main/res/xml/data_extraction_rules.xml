<?xml version="1.0" encoding="utf-8"?>
<!-- Datensicherung und Geräteumzug ab Android 12: dieselben Ausnahmen wie in backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="geheimnisse.xml" />
        <exclude domain="sharedpref" path="automatische_sicherung.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="geheimnisse.xml" />
        <exclude domain="sharedpref" path="automatische_sicherung.xml" />
    </device-transfer>
</data-extraction-rules>
