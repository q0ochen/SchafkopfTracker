<?xml version="1.0" encoding="utf-8"?>
<!--
    Streichholzschachtel als Zeichen für „gelegt“ (selbst gezeichnet, CC0).
    Links die Hülle mit Reibfläche, rechts die herausgezogene Schublade mit zwei Streichhölzern.
    Einfarbig, damit die Oberfläche das Symbol passend zum Hintergrund einfärben kann.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Hülle mit ausgesparter Reibfläche -->
    <path
        android:fillColor="#FF000000"
        android:fillType="evenOdd"
        android:pathData="M2.5,6.5 h11 a1,1 0 0 1 1,1 v9 a1,1 0 0 1 -1,1 h-11 a1,1 0 0 1 -1,-1 v-9 a1,1 0 0 1 1,-1 z M3.6,13.6 v1.8 h8.8 v-1.8 z" />

    <!-- herausgezogene Schublade -->
    <path
        android:fillColor="#00000000"
        android:pathData="M15.6,8.4 h6.1 v7.2 h-6.1"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.6" />

    <!-- zwei Streichhölzer: Holz und Kopf -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M15.2,9.9 h3 v1 h-3 z M15.2,13.1 h3 v1 h-3 z" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M17.9,10.4 a1.3,1.3 0 1 0 2.6,0 a1.3,1.3 0 1 0 -2.6,0 z M17.9,13.6 a1.3,1.3 0 1 0 2.6,0 a1.3,1.3 0 1 0 -2.6,0 z" />
</vector>
