<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Die App braucht derzeit kein Internet: Alles bleibt auf dem Gerät. Die Netzbibliothek (OkHttp, für die spätere
        KI-Zusammenfassung im Modul data) bringt die Berechtigung von selbst mit; sie wird hier wieder entfernt.
        Auch die automatische Sicherung braucht sie nicht: Sie schreibt über die Dateiauswahl von Android, und das
        Hochladen (zum Beispiel zu Google Drive) übernimmt die App des Anbieters.
        Erst wenn der Abend-Kommentator in die App kommt, diese Zeile löschen.
    -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <application
        android:name=".app.SchafkopfApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Gibt geteilte Bilder (Abschluss, Statistik) an die gewählte App weiter, nur mit Leserecht für dieses Bild. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.dateien"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
